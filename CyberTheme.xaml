<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GlitchStich">
  <Style x:Key="CyberButton" TargetType="Button">
    <Setter Property="Background" Value="#111D2B"/><Setter Property="Foreground" Value="#EAF5FF"/><Setter Property="BorderBrush" Value="#51D9E4"/>
    <Setter Property="Padding" Value="13,7"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid Background="Transparent">
      <Canvas IsHitTestVisible="False"><Path x:Name="Plate" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}" Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}" Data="M8,0 L100,0 L100,24 L92,32 L0,32 L0,8 Z" Stretch="Fill" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1"/>
      <Path Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}" Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}" Data="M0,7 L7,0 M93,32 L100,25" Stretch="Fill" Stroke="#F8D35C" StrokeThickness="2" IsHitTestVisible="False" Opacity="0.6"/></Canvas>
      <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
    </Grid><ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Plate" Property="Fill" Value="#223748"/><Setter TargetName="Plate" Property="Stroke" Value="#F8D35C"/></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter TargetName="Plate" Property="Fill" Value="#48233F"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Plate" Property="Stroke" Value="#F8D35C"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
    </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Button" BasedOn="{StaticResource CyberButton}"/>
  <Style TargetType="ScrollBar"><Setter Property="Background" Value="#0A141E"/><Setter Property="Foreground" Value="#365D6B"/><Setter Property="Width" Value="11"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="{TemplateBinding Background}"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}"><Track.Thumb><Thumb Background="{TemplateBinding Foreground}"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}" Margin="2" CornerRadius="0"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb></Track></Grid><ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="11"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ListBox">
    <Setter Property="Background" Value="#090F19"/><Setter Property="Foreground" Value="#EAF5FF"/><Setter Property="BorderBrush" Value="#294755"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"><ScrollViewer Focusable="False" CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}" Padding="{TemplateBinding Padding}"><ItemsPresenter/></ScrollViewer></Border></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ListBoxItem">
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Foreground" Value="#EAF5FF"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Item" Background="Transparent" BorderThickness="2,0,0,0" BorderBrush="Transparent" Padding="2"><ContentPresenter/></Border><ControlTemplate.Triggers>
      <Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="BorderBrush" Value="#F8D35C"/><Setter TargetName="Item" Property="Background" Value="#233C49"/></Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Item" Property="Background" Value="#172B38"/></Trigger>
    </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ProgressBar"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar"><Grid Background="#101F2A" Height="10" ClipToBounds="True"><Border BorderBrush="#315666" BorderThickness="1"/><Grid x:Name="PART_Track" Margin="2"><Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}"/></Grid><Path Data="M0,0 L6,0 L0,8 Z" Fill="#071019" HorizontalAlignment="Right" Width="6" Stretch="Fill" IsHitTestVisible="False"/></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox">
    <Setter Property="Background" Value="#0B1520"/><Setter Property="Foreground" Value="#EAF5FF"/><Setter Property="CaretBrush" Value="#51D9E4"/><Setter Property="BorderBrush" Value="#315666"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="InputFrame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}"><ScrollViewer x:Name="PART_ContentHost"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="InputFrame" Property="BorderBrush" Value="#F8D35C"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Background" Value="#101D2A"/><Setter Property="Foreground" Value="#EAF5FF"/><Setter Property="Padding" Value="9,6"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Choice" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Choice" Property="Background" Value="#29414D"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox"><Setter Property="Background" Value="#101D2A"/><Setter Property="Foreground" Value="#EAF5FF"/><Setter Property="BorderBrush" Value="#315666"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
    <ToggleButton Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#101D2A" BorderBrush="#315666" BorderThickness="1" Padding="8,5"><DockPanel><TextBlock DockPanel.Dock="Right" Text="⌄" Foreground="#F8D35C" Margin="10,0,0,0"/><ContentPresenter Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"/></DockPanel></Border></ControlTemplate></ToggleButton.Template></ToggleButton>
    <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="#101D2A" BorderBrush="#51D9E4" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="240"><ItemsPresenter/></ScrollViewer></Border></Popup>
  </Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#DDECF1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><DockPanel><Grid Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Top"><Path Data="M4,0 L16,0 L16,12 L12,16 L0,16 L0,4 Z" Fill="#142330" Stroke="#477888"/><Path x:Name="Check" Data="M3,8 L7,12 L13,4" Stroke="#F8D35C" StrokeThickness="2" Visibility="Collapsed"/></Grid><ContentPresenter VerticalAlignment="Center"/></DockPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.6"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>
