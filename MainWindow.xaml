<Window x:Class="GlitchStich.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:local="clr-namespace:GlitchStich" xmlns:fl="clr-namespace:FlyleafLib.Controls.WPF;assembly=FlyleafLib" Title="GlitchStich Studio" Icon="pack://application:,,,/GlitchStich;component/Resources/glitchstich.ico" Height="960" Width="1500" MinHeight="760" MinWidth="1120" WindowStyle="None" ResizeMode="CanResize" Background="#070910" Foreground="#EAF5FF" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <SolidColorBrush x:Key="Panel" Color="#0B101D" />
    <SolidColorBrush x:Key="Line" Color="#2A4B69" />
    <SolidColorBrush x:Key="Muted" Color="#849DBB" />
    <SolidColorBrush x:Key="Lime" Color="#52F3FF" />
    <SolidColorBrush x:Key="NeonPink" Color="#FF4FD8" />
    <DrawingBrush x:Key="CyberGrid" TileMode="Tile" Viewport="0,0,32,32" ViewportUnits="Absolute">
      <DrawingBrush.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#080B14" Geometry="M0,0 H32 V32 H0 Z" />
          <GeometryDrawing Brush="{x:Null}" Geometry="M0,0 H32 M0,0 V32">
            <GeometryDrawing.Pen>
              <Pen Brush="#14233A" Thickness="1" />
            </GeometryDrawing.Pen>
          </GeometryDrawing>
        </DrawingGroup>
      </DrawingBrush.Drawing>
    </DrawingBrush>
    <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource CyberButton}" />
    <Style x:Key="TrackButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
      <Setter Property="Padding" Value="7,4" />
      <Setter Property="FontSize" Value="10" />
    </Style>
    <Style x:Key="PanelBorder" TargetType="Border">
      <Setter Property="Background">
        <Setter.Value>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#EF111A2C" Offset="0" />
            <GradientStop Color="#F3080D18" Offset="1" />
          </LinearGradientBrush>
        </Setter.Value>
      </Setter>
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="local:CyberShape.Cut" Value="12" />
      <Setter Property="Effect">
        <Setter.Value>
          <DropShadowEffect Color="#07101C" BlurRadius="16" ShadowDepth="1" Opacity="0.75" />
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CyberInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Background" Value="#090D17" />
      <Setter Property="Foreground" Value="#EAF5FF" />
      <Setter Property="BorderBrush" Value="#31516D" />
      <Setter Property="CaretBrush" Value="#52F3FF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontFamily" Value="Consolas" />
    </Style>
    <Style x:Key="CyberList" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
      <Setter Property="Background" Value="#080C15" />
      <Setter Property="Foreground" Value="#EAF5FF" />
      <Setter Property="BorderBrush" Value="#23405A" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="3" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>
  </Window.Resources>
  <Grid x:Name="RootGrid" local:CyberShape.Cut="20" Margin="6" Background="{StaticResource CyberGrid}">
    <Grid.RowDefinitions>
      <RowDefinition Height="145" />
      <RowDefinition Height="*" MinHeight="180" />
      <RowDefinition Height="6" />
      <RowDefinition Height="0.65*" MinHeight="120" />
      <RowDefinition Height="140" />
    </Grid.RowDefinitions>
    <Border x:Name="HeaderPanel" Grid.Row="0" Style="{StaticResource PanelBorder}" Margin="0,0,0,8" Padding="12,6" MouseLeftButtonDown="WindowHeader_MouseLeftButtonDown">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="34" />
          <RowDefinition Height="34" />
          <RowDefinition Height="28" />
          <RowDefinition Height="22" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image x:Name="BrandAppIcon" Width="34" Height="34" Source="pack://application:,,,/GlitchStich;component/Resources/Brand/glitchstich-app.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" ToolTip="GlitchStich" />
          <StackPanel Margin="9,0,0,0" MaxWidth="430">
            <TextBlock Text="GlitchStich" FontSize="15" FontWeight="Bold" />
            <TextBlock Text="GLITCHES IN. STITCHES OUT." FontSize="8" Foreground="{StaticResource Muted}" FontFamily="Consolas" />
            <TextBlock x:Name="StatusText" Text="Ready · Local project" Foreground="#A8CE71" FontSize="9" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" Visibility="Collapsed" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="—" ToolTip="Minimize" Style="{StaticResource TrackButton}" Margin="0,0,3,0" Click="MinimizeWindow_Click" />
          <Button Content="□" ToolTip="Maximize or restore" Style="{StaticResource TrackButton}" Margin="0,0,3,0" Click="MaximizeWindow_Click" />
          <Button Content="×" ToolTip="Close GlitchStich" Style="{StaticResource TrackButton}" Foreground="#FF8DE4" Click="CloseWindow_Click" />
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
          <Button Content="▣  Open glitch" Style="{StaticResource ActionButton}" Padding="9,5" Margin="0,0,6,0" Click="OpenProject_Click" />
          <Button x:Name="SaveProjectButton" Content="▣  Save glitch" Style="{StaticResource ActionButton}" Padding="9,5" Margin="0,0,7,0" Click="SaveProject_Click" />
          <Button Content="＋  Import" Style="{StaticResource ActionButton}" Padding="11,5" Margin="0,0,7,0" Click="Import_Click" />
          <Button Content="♫  Extract audio" Style="{StaticResource ActionButton}" Padding="11,5" Margin="0,0,7,0" Click="ExtractAudio_Click" />
          <Button Content="✦ Generate draft stitch" Style="{StaticResource ActionButton}" Padding="11,5" Margin="0,0,7,0" BorderBrush="#F8D35C" Click="GenerateDraft_Click" />
          <Button x:Name="RecordButton" Content="●  Record" Style="{StaticResource ActionButton}" Padding="11,5" Background="#C62E8E" BorderBrush="#FF4FD8" Margin="0,0,7,0" Click="Record_Click" />
          <Button Content="Stitch tools" Style="{StaticResource ActionButton}" Padding="9,5" Margin="0,0,7,0" Click="OpenEditingTools_Click" />
          <Button Content="YouTube" Style="{StaticResource ActionButton}" Padding="9,5" Margin="0,0,7,0" Click="OpenYouTube_Click" />
          <Button Content="⇧  Export stitch" Style="{StaticResource ActionButton}" Padding="11,5" Click="ExportTimeline_Click" />
        </StackPanel>
        <TextBlock x:Name="TaskProgressDetail" Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding ElementName=StatusText, Path=Text}" Foreground="#B9D5E8" FontSize="10" TextWrapping="Wrap" ToolTip="{Binding ElementName=StatusText, Path=Text}" VerticalAlignment="Center" Margin="1,0,1,0" />
        <Grid Grid.Row="3" Grid.ColumnSpan="2" VerticalAlignment="Center">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="TaskProgressLabel" MaxWidth="450" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" Text="READY" Foreground="#52F3FF" FontFamily="Consolas" FontSize="8" Margin="1,0,8,0" VerticalAlignment="Center" />
          <ProgressBar x:Name="TaskProgress" Grid.Column="1" Height="10" Minimum="0" Maximum="100" Value="0" IsIndeterminate="False" Background="#09121F" Foreground="#52F3FF" BorderThickness="0" VerticalAlignment="Center" />
        </Grid>
      </Grid>
    </Border>
    <Grid Grid.Row="1" Margin="0,0,0,7">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="230" MinWidth="185" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition Width="*" MinWidth="380" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition Width="420" MinWidth="340" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource PanelBorder}" Padding="11">
        <DockPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" DockPanel.Dock="Top">
            <StackPanel>
              <TextBlock Text="01 // MEDIA VAULT" Foreground="{StaticResource Muted}" FontSize="9" FontWeight="Bold" Margin="2,2,0,5" />
              <TextBlock x:Name="ProjectName" Text="Untitled glitch" FontSize="14" FontWeight="SemiBold" Margin="2,5,0,8" />
              <Button Content="New glitch" Style="{StaticResource TrackButton}" HorizontalAlignment="Left" Margin="0,0,0,7" Click="NewProject_Click" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="MEDIA LIBRARY" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="＋ Add media" Style="{StaticResource TrackButton}" Padding="7,4" Click="Import_Click" />
              </Grid>
              <ListBox x:Name="MediaLibraryList" Height="190" Margin="0,6,0,0" Background="#090D17" BorderBrush="{StaticResource Line}" Foreground="#EAF5FF" SelectionChanged="MediaLibraryList_SelectionChanged">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border Background="#101827" BorderBrush="#24334A" BorderThickness="0,0,0,1" Padding="6">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="24" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Icon}" Foreground="#52F3FF" FontSize="14" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{Binding Name}" FontSize="10" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Details}" Foreground="{StaticResource Muted}" FontSize="8" Margin="0,2,0,0" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Button x:Name="AddAudioToTimelineButton" Content="＋ Add audio to timeline" Style="{StaticResource TrackButton}" Margin="0,5,0,0" Visibility="Collapsed" Click="AddLibraryAudio_Click" />
              <Border BorderBrush="{StaticResource Line}" BorderThickness="1" Background="#09111F" Margin="0,7,0,0" Padding="7">
                <StackPanel>
                  <TextBlock Text="▣  ACTIVE SOURCE" Foreground="#52F3FF" FontSize="8" FontFamily="Consolas" />
                  <TextBlock x:Name="MediaName" Text="No media loaded" Foreground="#EAF5FF" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0" />
                  <TextBlock x:Name="MediaDetails" Text="Add video, audio or PNG media." Foreground="{StaticResource Muted}" FontSize="9" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
              </Border>
              <Border Height="1" Background="{StaticResource Line}" Margin="0,10,0,8" />
              <TextBlock Text="CAPTURE INPUTS" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" />
              <CheckBox x:Name="SystemAudioCheck" IsChecked="True" Foreground="#DEE0E3" Margin="0,7,0,0">
                <StackPanel>
                  <TextBlock Text="System audio" FontSize="11" />
                  <TextBlock Text="Game and party sound" FontSize="9" Foreground="{StaticResource Muted}" />
                </StackPanel>
              </CheckBox>
              <CheckBox x:Name="MicCheck" IsChecked="True" Foreground="#DEE0E3" Margin="0,7,0,0">
                <StackPanel>
                  <TextBlock Text="Microphone" FontSize="11" />
                  <TextBlock Text="Saved as a separate track" FontSize="9" Foreground="{StaticResource Muted}" />
                </StackPanel>
              </CheckBox>
            </StackPanel>
          </ScrollViewer>
          <TextBlock x:Name="EngineStatus" DockPanel.Dock="Bottom" Text="Media engine not set" Foreground="{StaticResource Muted}" FontSize="9" TextWrapping="Wrap" Margin="0,8,0,0" />
        </DockPanel>
      </Border>
      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="#252A2F" />
      <Border Grid.Column="2" Style="{StaticResource PanelBorder}" Padding="10">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
            <RowDefinition Height="42" />
          </Grid.RowDefinitions>
          <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="02 // SOURCE FEED" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Button x:Name="SmoothPreviewButton" Content="◈  Smooth preview" Style="{StaticResource TrackButton}" Margin="9,0,0,0" Click="SmoothPreview_Click" IsEnabled="False" ToolTip="Create a lightweight playback copy to reduce stutter" />
            </StackPanel>
            <TextBlock x:Name="PreviewStatus" Text="Import a video to preview" Foreground="#B4B8BD" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" />
          </Grid>
          <Border Grid.Row="1" Background="#080C14" CornerRadius="1" BorderBrush="#263149" BorderThickness="1">
            <Grid>
              <fl:FlyleafHost x:Name="VideoPreviewHost" Visibility="Collapsed" />
              <Image x:Name="ImagePreview" Stretch="Uniform" Visibility="Collapsed" />
              <StackPanel x:Name="PreviewEmpty" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="◉" FontSize="42" Foreground="#2B6F8F" HorizontalAlignment="Center" />
                <TextBlock Text="Your video preview" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,7,0,2" />
                <TextBlock Text="Import media to start your edit" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" />
              </StackPanel>
            </Grid>
          </Border>
          <Grid Grid.Row="2" Margin="2,5,2,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="38" />
              <ColumnDefinition Width="57" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="57" />
              <ColumnDefinition Width="38" />
            </Grid.ColumnDefinitions>
            <Button x:Name="PlayButton" Content="▶" Grid.Column="0" Style="{StaticResource ActionButton}" Padding="0" IsEnabled="False" Click="Play_Click" />
            <TextBlock x:Name="CurrentTime" Text="00:00" Grid.Column="1" FontFamily="Consolas" Foreground="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Center" />
            <Slider x:Name="SeekSlider" Grid.Column="2" Minimum="0" Maximum="1" VerticalAlignment="Center" IsEnabled="False" PreviewMouseLeftButtonDown="SeekSlider_MouseLeftButtonDown" PreviewMouseLeftButtonUp="SeekSlider_MouseLeftButtonUp" />
            <TextBlock x:Name="DurationText" Text="00:00" Grid.Column="3" FontFamily="Consolas" Foreground="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Center" />
            <Button x:Name="MuteButton" Content="🔊" Grid.Column="4" Style="{StaticResource ActionButton}" Padding="0" Click="Mute_Click" />
          </Grid>
        </Grid>
      </Border>
      <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="#252A2F" />
      <Border Grid.Column="4" Style="{StaticResource PanelBorder}" Padding="13" x:Name="BookmarkPanel">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="20" />
            <RowDefinition Height="6" />
            <RowDefinition x:Name="BookmarkFooterRow" Height="2*" MinHeight="96" MaxHeight="360" />
          </Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="SCANNED BOOKMARKS" FontSize="13" FontWeight="Bold" />
            <Border Background="#123345" BorderBrush="#52F3FF" BorderThickness="1" Margin="8,0,0,0" Padding="5,2">
              <TextBlock Text="● READY" Foreground="#52F3FF" FontSize="8" FontFamily="Consolas" />
            </Border>
            <Button Content="Expand glitches" Style="{StaticResource TrackButton}" Margin="8,0,0,0" Padding="6,3" Click="ExpandBookmarks_Click" />
          </StackPanel>
          <TextBlock x:Name="CueSummary" Grid.Row="1" Text="Describe the sounds or visual moments you want to find." Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,8" />
          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="112" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ListBox x:Name="ScanCategoryList" Grid.Column="0" Background="#090D17" BorderBrush="#28334B" Foreground="#D9E9FF" SelectionChanged="ScanCategoryList_SelectionChanged">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Background="#111A2B" BorderBrush="#263853" BorderThickness="0,0,0,1" Padding="7">
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Count, StringFormat={}{0} moments}" FontSize="9" Foreground="#52F3FF" Margin="0,3,0,0" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <ListBox x:Name="CueList" Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="#ECEEF0" SelectionChanged="CueList_SelectionChanged">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Background="#121A29" BorderBrush="#32425F" BorderThickness="1" CornerRadius="1" Margin="0,3" Padding="8">
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <TextBlock Text="{Binding DisplayText}" FontSize="11" TextWrapping="Wrap" />
                      <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                        <Button Content="Keep" Tag="Keep" Style="{StaticResource TrackButton}" Margin="0,0,5,0" Click="ReviewCue_Click" />
                        <Button Content="Skip" Tag="Skip" Style="{StaticResource TrackButton}" Click="ReviewCue_Click" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
          <GridSplitter x:Name="BookmarkPanelSplitter" Grid.Row="3" Height="6" HorizontalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="#315666" ToolTip="Drag to resize the glitches list" />
          <Grid x:Name="ScanSettingsHost" Grid.Row="4">
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
                <Expander Header="Scan settings / game / Glitchy depth" Foreground="#9FBBC9" Margin="0,5,0,8">
                  <StackPanel>
                    <TextBlock Text="GAME / MODE (OPTIONAL)" Foreground="{StaticResource Muted}" FontSize="9" FontWeight="SemiBold" />
                    <Grid Margin="0,4,0,7">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Grid Margin="0,0,5,0">
                        <TextBox x:Name="GameTitleBox" MaxLength="120" Padding="5,3" FontSize="10" TextChanged="GameTitleBox_TextChanged" ToolTip="Game title, for example Fortnite or Gears of War" />
                        <TextBlock x:Name="GameTitlePlaceholder" Text="Game title" Foreground="#8D9BB7" Opacity="0.58" FontSize="10" Margin="6,5,4,0" VerticalAlignment="Top" IsHitTestVisible="False" />
                      </Grid>
                      <Grid Grid.Column="1" Margin="0,0,5,0">
                        <TextBox x:Name="GameModeBox" MaxLength="80" Padding="5,3" FontSize="10" TextChanged="GameModeBox_TextChanged" ToolTip="Game mode, for example Zero Build, Ranked, Campaign or Horde" />
                        <TextBlock x:Name="GameModePlaceholder" Text="Game mode" Foreground="#8D9BB7" Opacity="0.58" FontSize="10" Margin="6,5,4,0" VerticalAlignment="Top" IsHitTestVisible="False" />
                      </Grid>
                      <CheckBox x:Name="IRLModeCheck" Grid.Column="2" Content="IRL" Foreground="#52F3FF" FontSize="9" VerticalAlignment="Center" Checked="IRLMode_Checked" Unchecked="IRLMode_Checked" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,7">
                      <TextBlock Text="Lead-in (sec)" Foreground="{StaticResource Muted}" FontSize="9" VerticalAlignment="Center" />
                      <TextBox x:Name="ContextSecondsBox" Text="3" Width="36" Margin="5,0,10,0" Padding="4,2" Background="#090D17" Foreground="#E8EAEC" BorderBrush="#35445F" HorizontalContentAlignment="Center" />
                      <TextBlock Text="Match" Foreground="{StaticResource Muted}" FontSize="9" VerticalAlignment="Center" />
                      <TextBox x:Name="LaughThresholdBox" Text="0.15" Width="42" Margin="5,0,8,0" Padding="4,2" Background="#090D17" Foreground="#E8EAEC" BorderBrush="#35445F" HorizontalContentAlignment="Center" />
                      <TextBlock Text="Glitch s" Foreground="{StaticResource Muted}" FontSize="9" VerticalAlignment="Center" />
                      <TextBox x:Name="ClipDurationBox" Text="30" Width="34" Margin="5,0,0,0" Padding="4,2" Background="#090D17" Foreground="#E8EAEC" BorderBrush="#35445F" HorizontalContentAlignment="Center" ToolTip="Video review glitch length in seconds" />
                    </StackPanel>
                    <CheckBox x:Name="AiVerifyCandidatesCheck" IsChecked="True" Content="Glitchy reviews footage with detectors" Foreground="#FF70DA" FontSize="9" Margin="0,0,0,5" ToolTip="Local frames and audio review; suggests corrections and flags weak matches. Your decisions stay under your control." />
                    <TextBlock x:Name="CueHint" Text="One prompt scans 521 audio sound types and sampled video frames. Keep/Skip choices tune future cue rankings on this PC." Foreground="{StaticResource Muted}" FontSize="9" TextWrapping="Wrap" Margin="0,8,0,4" />
                    <ComboBox x:Name="CopilotReviewDepthBox" SelectedIndex="1" Margin="0,5">
                      <ComboBoxItem Content="Focused · 6 sampled windows" />
                      <ComboBoxItem Content="Balanced · 12 sampled windows" />
                      <ComboBoxItem Content="Thorough · 24 sampled windows" />
                    </ComboBox>
                  </StackPanel>
                </Expander>
                <StackPanel>
                  <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,5,0">
                      <TextBlock Text="STITCH INTENT" Foreground="{StaticResource Muted}" FontSize="9" FontWeight="SemiBold" />
                      <ComboBox FontSize="10" x:Name="EditModeBox" SelectedIndex="0" SelectionChanged="EditMode_Changed" Margin="0,4,0,0" ToolTip="Story keeps unreviewed scenes. Highlights/comedy select moments; all cuts require draft approval.">
                        <ComboBoxItem Content="Story / preserve context" />
                        <ComboBoxItem Content="Competitive highlights" />
                        <ComboBoxItem Content="Comedy / player reactions" />
                      </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="SECOND MODE (OPTIONAL)" Foreground="{StaticResource Muted}" FontSize="9" FontWeight="SemiBold" />
                      <ComboBox FontSize="10" x:Name="SecondaryEditModeBox" SelectedIndex="0" SelectionChanged="EditMode_Changed" Margin="0,4,0,0" ToolTip="Either mode can qualify a moment. Story in either slot preserves unreviewed scenes.">
                        <ComboBoxItem Content="None — one editing mode" />
                        <ComboBoxItem Content="Story / preserve context" />
                        <ComboBoxItem Content="Competitive highlights" />
                        <ComboBoxItem Content="Comedy / player reactions" />
                      </ComboBox>
                    </StackPanel>
                  </Grid>
                  <TextBlock Text="WHAT SHOULD THE SCAN LOOK FOR?" Foreground="{StaticResource Muted}" FontSize="9" FontWeight="SemiBold" />
                  <Grid Margin="0,5,0,5" MinHeight="42" MaxHeight="65">
                    <TextBox x:Name="PreferenceBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="42" MaxHeight="65" Margin="0" Padding="6" Background="#090D17" Foreground="#E8EAEC" BorderBrush="#35445F" TextChanged="PreferenceBox_TextChanged" PreviewKeyDown="PreferenceBox_PreviewKeyDown" ToolTip="Press Enter to start the scan; Shift+Enter inserts a new line" />
                    <TextBlock x:Name="PreferencePlaceholder" Text="What should we look for?" Foreground="#AEB5BA" Opacity="0.58" FontSize="11" Margin="7,8,6,0" VerticalAlignment="Top" IsHitTestVisible="False" />
                  </Grid>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
            <StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Grid.Row="1" Margin="0,5,0,1">
<StackPanel Orientation="Horizontal"><Button x:Name="StartScanButton" Content="✦  Start scan" Style="{StaticResource TrackButton}" Margin="0,0,5,0" Click="Analyze_Click" ToolTip="Scan using the selected editing modes plus any optional prompt. Leave the prompt blank to use modes only." /><Button Content="Review preference change" Style="{StaticResource TrackButton}" Click="ApplyPreference_Click" /></StackPanel>
<TextBlock x:Name="PreferenceStatus" Text="Selected modes + optional prompt guide the scan. Enter starts scanning." Foreground="{StaticResource Muted}" FontSize="9" TextWrapping="Wrap" Margin="0,4,0,0" />
</StackPanel>
          </Grid>
        </Grid>
      </Border>
    </Grid>
    <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="#252A2F" />
    <Border Grid.Row="3" Style="{StaticResource PanelBorder}" Padding="10">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="20" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Button x:Name="RestoreDraftButton" Content="Restore pre-draft" Style="{StaticResource TrackButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed" ToolTip="Restore the video ranges and layers from before the most recent draft. Current audio settings and bookmarks are retained." Click="RestoreDraft_Click" />
          <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
            <TextBlock Text="04 // STITCH TIMELINE" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
            <TextBlock Text="  Video + separate audio tracks · select a lane to remove it" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center" />
            <TextBlock Text="  Zoom" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center" Margin="12,0,3,0" />
            <Slider x:Name="ZoomSlider" Minimum="1" Maximum="8" Value="2.2" Width="100" VerticalAlignment="Center" ValueChanged="ZoomSlider_ValueChanged" />
          </StackPanel>
          <WrapPanel Grid.Row="1" Margin="0,8,0,8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="RemoveDuplicateAudioButton" Content="Remove duplicate audio" Style="{StaticResource TrackButton}" Margin="0,0,6,0" Visibility="Collapsed" Click="RemoveDuplicateAudio_Click" />
            <Button x:Name="ClipSelectedCueButton" Content="✂ Glitch selected bookmark" Style="{StaticResource TrackButton}" Margin="0,0,6,0" Visibility="Collapsed" Click="ClipSelectedCue_Click" />
            <Button x:Name="AddCueLayerButton" Content="＋ Cue to video layer" Style="{StaticResource TrackButton}" Margin="0,0,6,0" Visibility="Collapsed" Click="AddCueLayer_Click" />
            <Button Content="Undo" Style="{StaticResource TrackButton}" Margin="0,0,5,0" Click="UndoEdit_Click" />
            <Button Content="Redo" Style="{StaticResource TrackButton}" Margin="0,0,5,0" Click="RedoEdit_Click" />
            <Button Content="Split at playhead" Style="{StaticResource TrackButton}" Margin="0,0,6,0" Click="SplitVideoAtPlayhead_Click" />
            <Button x:Name="RemoveTimelineItemButton" Content="Remove selected" Style="{StaticResource TrackButton}" Margin="0,0,6,0" IsEnabled="False" Click="RemoveTimelineItem_Click" />
            <Button Content="Add cue at playhead" Style="{StaticResource TrackButton}" Margin="0,0,6,0" Click="AddCueAtPlayhead_Click" />
            <Button Content="Export stitch" Style="{StaticResource TrackButton}" Click="ExportTimeline_Click" />
          </WrapPanel>
        </Grid>
        <ScrollViewer x:Name="TimelineScroll" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#090D17">
          <Grid x:Name="TimelineTracks" HorizontalAlignment="Left" VerticalAlignment="Top" />
        </ScrollViewer>
        <TextBlock Grid.Row="2" x:Name="TimelineStatus" Text="Split at playhead · trim glowing edges · remove a glitch · export the kept timeline" Foreground="{StaticResource Muted}" FontSize="9" VerticalAlignment="Center" />
      </Grid>
    </Border>
    <local:GlitchyCompanion x:Name="GlitchyHost" Grid.Row="4" Margin="5,2,8,0" />
  </Grid>
</Window>