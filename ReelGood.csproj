<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PublishSingleFile>false</PublishSingleFile>
    <AssemblyName>ReelGood</AssemblyName>
    <Product>GlitchStich</Product>
    <AssemblyTitle>GlitchStich</AssemblyTitle>
    <Description>GlitchStich automatic video editor — glitches into stitches</Description>
    <ApplicationIcon>Resources\reelgood.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Resources\Brand\*.png;Resources\reelgood.ico" />
    <Content Include="Resources\reelgood.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Compile Remove="checks\**\*.cs" />
    <PackageReference Include="FlyleafLib" Version="3.11.8" />
    <PackageReference Include="Google.Apis.YouTube.v3" Version="1.77.0.4309" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <EmbeddedResource Include="tools\ffmpeg.exe" LogicalName="ReelGood.tools.ffmpeg.exe" />
    <EmbeddedResource Include="tools\ffprobe.exe" LogicalName="ReelGood.tools.ffprobe.exe" />
    <EmbeddedResource Include="Resources\Audio\Intro.wav" LogicalName="ReelGood.Audio.Intro.wav" />
    <EmbeddedResource Include="Resources\Audio\DraftReady.wav" LogicalName="ReelGood.Audio.DraftReady.wav" />
    <Content Include="Resources\Flyleaf\FFmpeg\*.dll;Resources\Flyleaf\THIRD-PARTY-NOTICES.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="tools\FFmpeg-GPLv3-LICENSE.txt;tools\FFmpeg-build-notes.txt;Resources\NAudio-LICENSE.txt;Resources\Google-Apache-LICENSE.txt;Resources\Newtonsoft-MIT-LICENSE.txt;Resources\YouTube-THIRD-PARTY-NOTICES.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Resources\LaughDetection\setup.ps1;Resources\LaughDetection\video_setup.ps1;Resources\LaughDetection\requirements.txt;Resources\LaughDetection\THIRD-PARTY-NOTICES.txt;Resources\LaughDetection\src\**\*.py;Resources\LaughDetection\src\**\*.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>
</Project>


